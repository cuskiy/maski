{
  "name": "maski",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, local-first Matrix client",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run code && npm run lint && node scripts/build.ts",
    "pages": "node scripts/pages.ts",
    "audit": "node scripts/audit.ts",
    "features": "node scripts/features.ts",
    "code": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --import-plugin --promise-plugin src scripts test && stylelint \"src/**/*.css\" \"static/**/*.css\" --max-warnings=0",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run code && npm run lint && npm test && npm run build:only && npm run audit && npm run contracts",
    "serve": "node scripts/static.ts",
    "contracts": "node scripts/contracts.ts",
    "build:only": "node scripts/build.ts"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.2",
    "matrix-js-sdk": "45.1.0"
  },
  "devDependencies": {
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "html-minifier-terser": "^7.2.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "1.65.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "7.0.2",
    "web-features": "^3.46.0"
  },
  "engines": {
    "node": ">=24"
  }
}
